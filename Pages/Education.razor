@page "/education"

<PageTitle>Education | @SiteContent.Name</PageTitle>
<HeadContent>
    <meta name="description" content="Emmanuel Olafisoye's academic background, professional training, and community leadership." />
</HeadContent>

<main class="route-shell">
    <RouteHeader Href="/education" Tag="Education" Class="education-route-header">
        <h1>Learning is part of the work.</h1>
        <p>Academic foundations, practical training, and leadership experiences that continue to shape how I work.</p>
    </RouteHeader>

    <section class="education-route-grid">
        <article class="education-feature">
            <span class="education-kicker">Academic foundation</span>
            <h2>B.Sc. Computer Science</h2>
            <p>Wellspring University</p>
            <time datetime="2017-09/2021-01">September 2017 — January 2021</time>
        </article>
        <article class="education-list-card">
            <span class="education-kicker">Additional training</span>
            <ul>
                <li>Web Development — NIIT</li>
                <li>Advanced JavaScript &amp; React.js — Edo Innovates</li>
                <li>Digital Literacy Trainer — Tech4Dev</li>
            </ul>
        </article>
    </section>

    <section class="route-panel leadership-route-panel">
        <span class="education-kicker">Leadership &amp; community</span>
        <h2>Service beyond the screen.</h2>
        <ul class="leadership-route-list">
            <li>Vice President — Educational Development Group (EDG)</li>
            <li>Deputy Chief Liaison Officer — Nigerian Air Force (NYSC, 2022)</li>
            <li>Presiding Officer — INEC Nigeria, 2023 General Elections</li>
        </ul>
    </section>
</main>
